# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted. Used for Paystack callbacks.
APP_URL="https://your-deployed-domain.example"

# Supabase Configuration
# Optional: Can also be configured directly through the in-app Admin Dashboard
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Paystack checkout
# This is a same-origin Vercel API route by default. Set a full URL if the API
# is hosted separately.
VITE_PAYSTACK_API_URL="/api/paystack"

# Server-only variables. Add these in the Vercel project environment settings;
# never prefix these with VITE_ and never expose them in the browser.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
PAYSTACK_SECRET_KEY="sk_test_your-paystack-secret-key"
